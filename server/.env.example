# Port for the Node.js Express Server
PORT=5000

# MongoDB Connection URI (Local or Atlas)
MONGODB_URI=mongodb://localhost:27017/novalearn
# Example MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.abcde.mongodb.net/novalearn?retryWrites=true&w=majority

# Optional: Google Gemini API Key
GEMINI_API_KEY=
